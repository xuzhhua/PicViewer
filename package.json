{
  "name": "picviewer",
  "version": "1.0.0",
  "description": "Web-based local image browser with network drive support",
  "author": "xuzhhua <xuzhhua@msn.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xuzhhua/PicViewer.git"
  },
  "main": "electron-main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "test": "node tests/limiter.test.js && node tests/mergeBrowse.test.mjs && node tests/metaCache.test.js && node tests/httpCache.test.js && node tests/jsonCompression.test.js && node tests/previewParams.test.js && node tests/thumbParams.test.js && node tests/range.test.js && node tests/pathGuard.test.js && node tests/cors.test.js && node tests/cacheKeys.test.js && node tests/aiMeta.test.js && node tests/mediaUrl.test.mjs",
    "setup": "npm install && cd client && npm install",
    "electron": "electron .",
    "electron:dev": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder",
    "electron:dist:win": "npm run build && electron-builder --win",
    "electron:dist:mac": "npm run build && electron-builder --mac",
    "electron:dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.picviewer.app",
    "productName": "PicViewer",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "LICENSE",
      "electron-main.js",
      "server/**/*",
      "!server/cache/**",
      "!server/data/*.json",
      "client/dist/**/*",
      "client/public/icons/icon-*.png",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "client/public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PicViewer"
    },
    "mac": {
      "target": "dmg",
      "icon": "client/public/icons/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "client/public/icons/icon-512.png"
    }
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dicom-parser": "^1.8.21",
    "express": "^4.21.0",
    "sharp": "^0.33.0",
    "trash": "^7.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
